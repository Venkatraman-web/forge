{
 "uid": "forge-overview",
 "title": "Forge overview",
 "tags": [
  "forge"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 5,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "type",
    "label": "Job type",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "forge-prometheus"
    },
    "query": {
     "query": "label_values(forge_queue_jobs, type)",
     "refId": "t"
    },
    "definition": "label_values(forge_queue_jobs, type)",
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Is the queue keeping up?",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Oldest due job age",
   "description": "How long the oldest due queued job has waited. Rising while workers are idle means they are not claiming; rising while running equals your concurrency means workers are saturated.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "forge_queue_oldest_due_age_seconds{type=~\"$type\"}",
     "legendFormat": "{{type}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Queued and running jobs",
   "description": "Jobs waiting (queued) and being executed (running), per job type.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "forge_queue_jobs{type=~\"$type\"}",
     "legendFormat": "{{type}} {{state}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "row",
   "title": "Latency",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Queue wait p50 / p95",
   "description": "Time between a job becoming due and being claimed (histogram, per Forge process). This is the latency your scaling changes should reduce.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, type) (rate(forge_job_queue_wait_seconds_bucket{type=~\"$type\"}[1m])))",
     "legendFormat": "p50 {{type}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, type) (rate(forge_job_queue_wait_seconds_bucket{type=~\"$type\"}[1m])))",
     "legendFormat": "p95 {{type}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Attempt duration p50 / p95",
   "description": "Time from claim to Forge recording the outcome (includes the worker reporting delay). Compare with the job timeout.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, type) (rate(forge_job_attempt_duration_seconds_bucket{type=~\"$type\"}[1m])))",
     "legendFormat": "p50 {{type}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, type) (rate(forge_job_attempt_duration_seconds_bucket{type=~\"$type\"}[1m])))",
     "legendFormat": "p95 {{type}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "row",
   "title": "Throughput and reliability",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Job events per second",
   "description": "claimed, succeeded, retried, failed, released per second, by type.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "sum by (type, event) (rate(forge_job_events_total{type=~\"$type\", event=~\"claimed|succeeded|retried|failed|released\"}[1m]))",
     "legendFormat": "{{type}} {{event}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Timeouts, panics, lost ownership and reaper recoveries per second",
   "description": "Attempts that hit their timeout or panicked, claims that were lost (counted under type other), and jobs recovered by the reaper after a worker stopped renewing.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "sum by (type, event) (rate(forge_job_events_total{event=~\"attempt_timeout|attempt_panic|ownership_lost\"}[1m]))",
     "legendFormat": "{{type}} {{event}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "sum by (outcome) (rate(forge_reaper_recovered_total[1m]))",
     "legendFormat": "reaper {{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "Submissions and Forge itself",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Submissions per second by result",
   "description": "accepted, queue_full (raise FORGE_MAX_QUEUED or add workers), admission_busy (per-process submission ceiling), invalid, error.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "sum by (type, result) (rate(forge_submissions_total{type=~\"$type\"}[1m]))",
     "legendFormat": "{{type}} {{result}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Queue capacity",
   "description": "Queued jobs against FORGE_MAX_QUEUED.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "sum(forge_queue_jobs{state=\"queued\"})",
     "legendFormat": "queued"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "forge_queue_limit",
     "legendFormat": "limit"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Admission slots in use",
   "description": "The bounded submission admission step (3 slots per Forge process).",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "forge_admission_slots_in_use",
     "legendFormat": "in use"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "forge_admission_slots_total",
     "legendFormat": "total"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Database pool",
   "description": "Forge's 10-connection pool. Waiting time rising means the pool is the bottleneck.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "forge_db_pool_connections",
     "legendFormat": "{{state}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "forge_db_pool_max_connections",
     "legendFormat": "max"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "rate(forge_db_pool_wait_seconds_total[1m])",
     "legendFormat": "wait s/s"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 15,
   "type": "row",
   "title": "Machines (needs node_exporter on each machine)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 44,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "CPU busy %",
   "description": "Share of CPU time not idle, per machine. A machine near 100% is a bottleneck.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 45,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "100 * (1 - avg by (machine, instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
     "legendFormat": "{{machine}} {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "CPU waiting for disk (iowait) and stolen CPU (steal) %",
   "description": "iowait: the CPU is waiting for the disk, typical of a database waiting for commits. steal: the hypervisor is withholding CPU, typical of throttled burstable machines.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 45,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "100 * avg by (machine, instance) (rate(node_cpu_seconds_total{mode=\"iowait\"}[1m]))",
     "legendFormat": "iowait {{machine}} {{instance}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "100 * avg by (machine, instance) (rate(node_cpu_seconds_total{mode=\"steal\"}[1m]))",
     "legendFormat": "steal {{machine}} {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Memory available %",
   "description": "Memory the machine could still hand out, as a share of its total.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 53,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "legendFormat": "{{machine}} {{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 19,
   "type": "timeseries",
   "title": "Disk busy %",
   "description": "Share of time the disk had requests in flight. Near 100% means the disk is the limit.",
   "datasource": {
    "type": "prometheus",
    "uid": "forge-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 53,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "forge-prometheus"
     },
     "expr": "100 * rate(node_disk_io_time_seconds_total{device!~\"loop.*|dm-.*\"}[1m])",
     "legendFormat": "{{machine}} {{instance}} {{device}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
