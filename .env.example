# LOCAL DEVELOPMENT TEMPLATE. Copy to .env (cp .env.example .env), then REPLACE
# CHANGE_ME_before_first_start with your own password in BOTH places below
# (POSTGRES_PASSWORD and inside FORGE_DATABASE_URL) before the first
# "docker compose up". .env is ignored by Git. Never put real or production
# credentials in this file.

POSTGRES_USER=forge
POSTGRES_PASSWORD=CHANGE_ME_before_first_start
POSTGRES_DB=forge

# Host port on 127.0.0.1. Change it if 5432 is already in use on your machine.
FORGE_POSTGRES_PORT=5432

# Connection URL Forge and the Atlas CLI use. Keep the user, password, port and
# database in sync with the values above; URL-encode special characters in the
# password. sslmode=disable is acceptable only for this loopback-only local database.
FORGE_DATABASE_URL=postgres://forge:CHANGE_ME_before_first_start@127.0.0.1:5432/forge?sslmode=disable

# --- Forge in Docker (docker compose --profile forge up -d --build) ---
# Three different secrets, at least 32 characters each, for example from:
#   openssl rand -hex 24
# The submit key lets clients submit and read jobs (FORGE_API_KEY); the worker
# key lets workers claim and finish jobs; the operator key lets Prometheus and
# operators read /v1/queues and /metrics. Never reuse one for another role.
FORGE_API_KEY=
FORGE_WORKER_API_KEY=
FORGE_OPERATOR_API_KEY=
# Address Forge's ports are published on. 127.0.0.1 = this machine only. Set the machine's private IP to let your
# application and workers on other machines connect (private network only).
# FORGE_BIND=127.0.0.1
# Only for the optional observability profile (Prometheus and Grafana).
# FORGE_GRAFANA_ADMIN_PASSWORD is required (at least 12 characters); Grafana
# will not start without it. Prometheus keeps FORGE_PROMETHEUS_RETENTION of history.
FORGE_GRAFANA_ADMIN_PASSWORD=
FORGE_PROMETHEUS_RETENTION=15d
# Only if you also scrape ForgeCart's shop API (forgecart/README.md): the same value as its FORGECART_METRICS_KEY.
FORGECART_METRICS_KEY=
# Job types your workers handle (comma separated). hello.greet is only an example name.
FORGE_REMOTE_JOB_TYPES=hello.greet
